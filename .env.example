# Docker local (docker compose up -d)
DATABASE_URL="postgresql://contentsync:contentsync@localhost:5432/contentsync?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth.js — Google OAuth (https://console.cloud.google.com/apis/credentials)
# URI de redirection autorisée : http://localhost:3000/api/auth/callback/google
AUTH_SECRET="" # openssl rand -base64 32
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Prod uniquement (sinon erreur UntrustedHost) : AUTH_URL="https://votre-domaine.com"

# Anthropic (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Chiffrement des jetons des réseaux sociaux (32 octets en base64)
ENCRYPTION_KEY=""

